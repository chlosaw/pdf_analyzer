# Copy to .env (`cp .env.example .env`). Used by docker compose and by `npm run dev`.
# Every variable the app reads is listed here. No real values: fill in your own.

# --- Database ------------------------------------------------------------------
# Local dev (npm run dev). docker compose overrides this to point at its own db container.
# Neon: use the *direct* (non-pooled) connection string with ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdf_analyzer
# Used by `npm test` (wiped between test files) and `npm run test:e2e`
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdf_analyzer_test
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdf_analyzer_e2e

# --- Auth ----------------------------------------------------------------------
# At least 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
# Secure cookies (HTTPS only). Defaults to true when NODE_ENV=production; docker compose sets false for http://localhost.
COOKIE_SECURE=

# --- AI (Google Gemini) ------------------------------------------------------
# "fake" runs offline with deterministic embeddings and extractive answers (no key needed).
# "gemini" needs a free key from https://aistudio.google.com/apikey
# Embeddings from the two providers are not comparable: re-upload (or re-seed) after switching.
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Retries go to this lighter model when the main one is overloaded (503) or too slow
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- File storage --------------------------------------------------------------
# "local" writes to LOCAL_STORAGE_DIR. "supabase" uses a private Supabase Storage bucket (production:
# Render's disk is wiped on every restart).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=pdfs

# --- Server ----------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Reverse proxies in front of the API (nginx = 1; nginx + Render's load balancer = 2)
TRUST_PROXY=1
# Other browser origins allowed to call the API (comma-separated). Leave empty when the web app is served
# from the same origin, as it is with docker compose and on Render.
CORS_ORIGINS=
# Create the demo account (demo@pdf-analyzer.dev / demo1234) with sample PDFs when the container starts
SEED_DEMO=true
# Optional: also create an administrator (admin page at /admin). Use a real password of 12+ characters.
# Or promote an existing account: npm run make-admin -w apps/api -- you@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
