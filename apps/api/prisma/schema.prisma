generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  documents    Document[]
  chats        Chat[]
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

model Document {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  storageKey String
  sizeBytes  Int
  pageCount  Int
  status     DocumentStatus @default(PROCESSING)
  error      String?
  createdAt  DateTime       @default(now())
  chunks     Chunk[]
  chats      Chat[]

  @@index([userId, createdAt])
}

/// A slice of a single page's text plus its embedding.
/// Prisma has no native vector type, so the column is read/written with raw SQL.
model Chunk {
  id         String                       @id @default(uuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(768)")?

  @@index([documentId])
}

model Chat {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  /// true for the single chat that belongs to one document ("chat history per document")
  isDocumentChat Boolean    @default(false)
  documents      Document[]
  messages       Message[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId, updatedAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  /// Citation[] (see @pdf-analyzer/shared)
  citations Json        @default("[]")
  createdAt DateTime    @default(now())

  @@index([chatId, createdAt])
}
