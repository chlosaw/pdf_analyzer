# Rendered by the nginx image at startup: ${API_UPSTREAM} comes from the environment
# (http://api:4000 in docker compose, the API's public URL on Render).
server {
  listen 80;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
    # Answers stream as Server-Sent Events: pass every chunk through immediately.
    proxy_buffering off;
    proxy_read_timeout 300s;
    client_max_body_size 16m;
  }

  # Hashed build assets can be cached forever
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;
  }
}
