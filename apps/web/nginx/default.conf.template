# Rendered by the nginx image at startup: ${API_UPSTREAM} comes from the environment
# (http://api:4000 in docker compose, the API's public URL on Render).
server {
  listen 80;
  root /usr/share/nginx/html;
  server_tokens off; # don't advertise the nginx version

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The browser-facing host, so the API's CSRF origin check can compare it with Origin
    proxy_set_header X-Forwarded-Host $host;
    proxy_ssl_server_name on;
    # Answers stream as Server-Sent Events: pass every chunk through immediately.
    proxy_buffering off;
    proxy_read_timeout 300s;
    client_max_body_size 16m;
  }

  # Hashed build assets can be cached forever
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/security-headers.conf;
  }

  location / {
    try_files $uri /index.html;
    # index.html must be revalidated so a deploy (or security fix) reaches users straight away
    add_header Cache-Control "no-cache";
    include /etc/nginx/security-headers.conf;
  }
}
